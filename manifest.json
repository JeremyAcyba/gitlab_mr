{
    "manifest_version": 3,
    "name": "Gitlab enhancer",
    "version": "4.1",
    "description": "Gitlab extension to enhance the user experience on the merge request process",
    "permissions": ["storage"],
    "action": {
        "default_popup": "src/popup/index.html",
        "default_icon": "images/image.png"
    },
    "icons": {
        "16": "images/image.png",
        "128": "images/image.png"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "run_at": "document_idle",
            "css": ["src/content/content.css"],
            "js": [
                "src/shared/settings.js",
                "src/content/dom.js",
                "src/content/api.js",
                "src/content/instance.js",
                "src/content/status.js",
                "src/content/decorate.js",
                "src/content/review.js",
                "src/content/pages.js",
                "src/content/threads.js",
                "src/content/main.js"
            ]
        }
    ]
}
